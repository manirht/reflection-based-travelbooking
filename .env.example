# ============================================
# LLM Configuration (REQUIRED)
# ============================================
# Using Groq for fast inference with tool calling support
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3-32b
# Alternative models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_TEMPERATURE=0

# ============================================
# Travel Data (NO API KEYS NEEDED!)
# ============================================
# All travel data (flights, hotels, trains, car rentals) is hardcoded
# No external API calls are made

# ============================================
# Train Search (Using Hardcoded Data)
# ============================================
# No API key needed - using mock data for trains

# ============================================
# Optional: LangSmith Tracing (for debugging)
# ============================================
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=travel-booking-system

# ============================================
# API Configuration
# ============================================
# Retry settings for API calls
API_MAX_RETRIES=3
API_RETRY_DELAY=2
API_TIMEOUT=30

